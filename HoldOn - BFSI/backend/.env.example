# Copy to .env and fill in. Every key is optional: without it HoldOn runs its offline path.

# --- Gemini (AI Studio, paid tier: free-tier prompts may be used to improve Google products) ---
GEMINI_API_KEY=
# Model IDs are config, not code. Confirm with `uv run python spikes/list_models.py`.
HOLDON_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
HOLDON_FLASH_MODEL=gemini-2.5-flash
HOLDON_REPORT_MODEL=gemini-2.5-flash

# Vertex AI later (data residency asia-southeast1): set these instead of GEMINI_API_KEY.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=asia-southeast1

# --- Trusted contact via Telegram (create a bot with @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Detection ---
# auto = Gemini when GEMINI_API_KEY is set, else heuristic. Force with gemini|heuristic.
HOLDON_DETECTOR=auto
HOLDON_ALERT_THRESHOLD=0.7

# --- Web ---
HOLDON_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HOLDON_PUBLIC_WEB_URL=http://localhost:3000
