# Gemini (Google AI Studio key). Without it the backend runs on rules only.
GEMINI_API_KEY=
RELAY_GEMINI_MODEL=gemini-flash-latest

# Shared secrets. Leave empty only for local development.
RELAY_DEVICE_KEY=
RELAY_OPERATOR_KEY=

# Enables POST /v1/dev/inject.
RELAY_DEV_MODE=1
RELAY_DB_PATH=relay.db
RELAY_TIMEZONE=Asia/Kolkata
RELAY_CORS_ORIGINS=*
