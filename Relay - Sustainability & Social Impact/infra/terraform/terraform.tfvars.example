# Copy to terraform.tfvars (git-ignored). deploy.sh passes these on the CLI,
# so this file is only needed for manual terraform runs. Never put the Gemini key
# here; export TF_VAR_gemini_api_key instead.
project_id      = "your-gcp-project-id"
region          = "us-central1"
gemini_model    = "gemini-flash-latest"
# Pro-tier writer for the hourly per-district sitrep; Flash (gemini_model) is the fallback.
sitrep_gemini_model = "gemini-pro-latest"
max_instances   = 3
# Full image URI; deploy.sh sets this after building.
image = "us-central1-docker.pkg.dev/your-gcp-project-id/relay/relay:TAG"
