<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Debug-only automation hooks. They are exported but guarded by android.permission.DUMP, which the adb
      shell holds and ordinary apps cannot obtain, so only `adb shell` (or the system) can call them.
    -->
    <application>
        <service
            android:name="org.relay.app.RelayService"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:node="merge"
            tools:replace="android:exported" />

        <receiver
            android:name="org.relay.app.debug.DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="org.relay.app.DEBUG_SEND" />
                <action android:name="org.relay.app.DEBUG_CONFIG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
