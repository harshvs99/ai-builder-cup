# Backend base URL (default: http://localhost:8080)
VITE_API_BASE=http://localhost:8080

# Operator key: only needed when the backend sets RELAY_OPERATOR_KEY (sent as X-Operator-Key).
# Leave unset for an open backend. A ?key=... URL param is also accepted (saved to localStorage,
# then removed from the address bar) and takes precedence over this value.
# VITE_OPERATOR_KEY=
